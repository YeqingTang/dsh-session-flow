{
  "name": "dsh-session-flow",
  "description": "会话信息流重设计插件：折叠汇总 + 会话总览归档 + 深链跳转 + 子代理血缘树 + 摘要引擎（规则/LLM 双模式），实时复用原生轨迹数据",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "keywords": [
    "dsh",
    "agent-harness",
    "plugin",
    "web",
    "ui",
    "session",
    "trajectory"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/YeqingTang/dsh-session-flow.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-connection": "*"
  }
}
