{
  "name": "dsh-session-flow",
  "description": "DSH 会话回顾与归档插件：可折叠信息流 + 会话级汇总——总览工作台、折叠时间线、血缘树、双模式摘要、全文检索、ZIP 导出、实时跟踪、会话重命名（官方数据源对齐）、健康监控",
  "version": "1.4.1",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "assets/screenshots/"
  ],
  "keywords": [
    "dsh",
    "agent-harness",
    "plugin",
    "web",
    "ui",
    "session",
    "trajectory"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "build:client": "esbuild src/client.js --bundle --minify --format=cjs --platform=browser --external:react --external:react-dom/client --charset=utf8 --outfile=lib/client.js --log-level=warning"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YeqingTang/dsh-session-flow.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.1": "unknown",
        "0.1.3-alpha.2": "compatible"
      }
    }
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
